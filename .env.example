# Server-side only. Never expose this to the browser.
# Create a key at https://console.x.ai
XAI_API_KEY=

# Public site URL for sitemap / canonicals
NEXT_PUBLIC_SITE_URL=https://www.marketsxhub.com

# Supabase (Auth + Postgres). Create a project, then run supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — webhook / admin plan updates (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Billing (Checkout + webhooks). Create Desk / Founding / Floor Prices in Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_DESK_PRICE_ID=
NEXT_PUBLIC_STRIPE_FOUNDING_PRICE_ID=
NEXT_PUBLIC_STRIPE_FLOOR_PRICE_ID=
